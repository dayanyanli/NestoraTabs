{
  "manifest_version": 3,
  "name": "NestoraTabs",
  "short_name": "NestoraTabs",
  "description": "Save, organize and reopen your everyday websites in one click.",
  "version": "1.0.1",
  "permissions": [
    "activeTab",
    "bookmarks",
    "contextMenus",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "NestoraTabs",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
